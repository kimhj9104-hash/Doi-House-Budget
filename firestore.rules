rules_version = '2';

// 두이네 가계부 Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 파일 전체를 붙여넣고 게시(Publish)하세요.

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(householdId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    // 로그인한 사용자가 어느 가구에 속해있는지 알려주는 문서 (1인 1가구)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // 초대 코드 -> 가구 ID 매핑
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /households/{householdId} {
      allow read, update: if isMember(householdId);
      allow create: if request.auth != null;

      match /members/{uid} {
        allow read: if isMember(householdId);
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if request.auth != null && request.auth.uid == uid;
      }

      match /categories/{categoryId} {
        allow read, write: if isMember(householdId);
      }

      match /recurringTransactions/{recurringId} {
        allow read, write: if isMember(householdId);
      }

      match /transactions/{transactionId} {
        allow read, update, delete: if isMember(householdId);
        allow create: if isMember(householdId) && request.resource.data.uid == request.auth.uid;
      }
    }
  }
}
