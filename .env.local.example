# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹 앱) 에서 나오는 설정값을 그대로 옮겨 적으세요.
NEXT_PUBLIC_FIREBASE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xxxxxxxxxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xxxxxxxxxx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xxxxxxxxxx.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_APP_ID=1:xxxxxxxxxxxx:web:xxxxxxxxxxxxxxxxxxxxxx

# Google 캘린더 연동 (설정 화면의 "Google 캘린더 연동"에서 사용)
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 에서 발급받은 OAuth 클라이언트 값
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# 배포된 앱의 기본 URL. Google Console에 등록한 리디렉션 URI와 정확히 일치해야 해요.
# (로컬 개발 시에는 http://localhost:3000)
APP_BASE_URL=https://xxxxxxxxxx.example.com
# OAuth state 파라미터 서명용 임의의 긴 랜덤 문자열 (아무도 모르게 직접 생성해서 채우세요)
GOOGLE_OAUTH_STATE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase 서비스 계정 (Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성)
# 다운로드한 JSON 파일의 값을 그대로 옮겨 적으세요. 절대 Git에 커밋하지 마세요.
FIREBASE_ADMIN_CLIENT_EMAIL=xxxxxxxxxxxx@xxxxxxxxxx.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"
